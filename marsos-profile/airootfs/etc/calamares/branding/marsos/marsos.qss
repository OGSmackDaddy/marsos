/* marsOS Cyber Sol Theme for Calamares */

QWidget {
    background-color: #0d0f14;
    color: #e6edf3;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

QTreeView, QListView, QTableView {
    background-color: #161822;
    border: 1px solid rgba(255, 42, 85, 0.2);
    border-radius: 8px;
    selection-background-color: #FF2A55;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #1e2230;
    color: #ffffff;
    border: 1px solid rgba(255, 42, 85, 0.4);
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #FF2A55;
    border-color: #FF6B00;
}

QPushButton:pressed {
    background-color: #d61840;
}

QProgressBar {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background-color: #161822;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF2A55, stop:1 #FF6B00);
    border-radius: 5px;
}

QLabel {
    background: transparent;
}
